# --- DataForSEO (the live map data) ---
# Get these from https://app.dataforseo.com/api-access
# These are NOT your website login. They are a separate API login/password pair.
export DFS_LOGIN="paste-your-api-login-here"
export DFS_PASSWORD="paste-your-api-password-here"

# --- Anthropic (writes the analyze and content output) ---
# Get a key from https://console.anthropic.com/settings/keys (starts with sk-ant-)
export ANTHROPIC_API_KEY="paste-your-anthropic-key-here"

# Which data source to use for scans: mock | dataforseo
export GRIDSCOUT_PROVIDER="dataforseo"

# Optional: which Claude model writes the analysis and content. Default shown.
export GRIDSCOUT_MODEL="claude-sonnet-4-6"
