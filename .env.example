# DataForSEO API credentials
# Get these from https://app.dataforseo.com/api-access
# These are NOT your website login. They are a separate API login/password pair.

export DFS_LOGIN="paste-your-api-login-here"
export DFS_PASSWORD="paste-your-api-password-here"

# Which data source to use: mock | dataforseo
export GRIDSCOUT_PROVIDER="dataforseo"
